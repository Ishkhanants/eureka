# Copy this file to .env (or export these as real environment variables)
# before running the app. Never commit real values.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/eureka
DB_USERNAME=root
DB_PASSWORD=

# --- Mail (used to send issue-assignment notifications) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# --- Security ---
# Long random string used to sign "remember me" tokens
SECURITY_SECRET_KEY=change-this-to-a-long-random-string-in-production
